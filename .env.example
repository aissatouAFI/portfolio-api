APP_NAME="Mon Portfolio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Base de données (MySQL via XAMPP) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=root
DB_PASSWORD=

# --- JWT (tymon/jwt-auth) ---
# Généré automatiquement par : php artisan jwt:secret
JWT_SECRET=

# --- Mail (Gmail SMTP) ---
# ⚠️ N'utilise PAS ton mot de passe Gmail normal.
# Va sur https://myaccount.google.com/apppasswords pour générer
# un "mot de passe d'application" (nécessite la validation en 2 étapes activée).
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ton.adresse@gmail.com
MAIL_PASSWORD="mot-de-passe-application-16-caracteres"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="ton.adresse@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Adresse qui recevra les messages du formulaire de contact
# (généralement la même que MAIL_USERNAME)
MAIL_TO_ADDRESS=ton.adresse@gmail.com

# --- CORS (adresse de ton frontend React en local) ---
# Plusieurs origines possibles, séparées par des virgules, sans slash final.
FRONTEND_URL=http://localhost:5173

# --- Production (Railway) ---
# Ces valeurs se règlent dans les variables du service Railway, jamais dans un fichier :
#   APP_ENV=production, APP_DEBUG=false, APP_URL=https://<domaine-railway>
#   DB_* reliées au service MySQL, LOG_CHANNEL=stderr, SESSION_SECURE_COOKIE=true
#   FRONTEND_URL=https://<domaine-vercel>
#   MAIL_MAILER=log (Railway bloque le SMTP hors offre Pro)
#   RAILPACK_PHP_EXTENSIONS=intl,gd,zip,exif,bcmath
